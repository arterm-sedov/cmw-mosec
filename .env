# =============================================================================
# CMW-Mosec Configuration
# =============================================================================
# This file specifies which models are loaded by the server.
# YAML config (config/models.yaml) contains all available models.
#
# Available models (run: cmw-mosec models):
#   Embeddings:
#     - ai-forever/FRIDA (~4GB)
#     - Qwen/Qwen3-Embedding-0.6B (~2GB)
#     - Qwen/Qwen3-Embedding-4B (~12GB)
#     - Qwen/Qwen3-Embedding-8B (~22GB)
#
#   Rerankers:
#     - DiTy/cross-encoder-russian-msmarco (~2GB)
#     - BAAI/bge-reranker-v2-m3 (~2GB)
#     - Qwen/Qwen3-Reranker-0.6B (~2GB)
#     - Qwen/Qwen3-Reranker-4B (~12GB)
#     - Qwen/Qwen3-Reranker-8B (~22GB)
#
#   Guards:
#     - Qwen/Qwen3Guard-Gen-0.6B (~4GB)
#     - Qwen/Qwen3Guard-Gen-4B (~10GB)
#     - Qwen/Qwen3Guard-Gen-8B (~20GB)
#
# Usage:
#   cmw-mosec serve           # Start server with models from .env
#   cmw-mosec load <model>   # Load model into running server
#   cmw-mosec unload <model>  # Unload model from running server
# =============================================================================

# =============================================================================
# Active Models (one per type)
# =============================================================================
# These models will be loaded when starting the server.
# Model slugs are case-insensitive.

# Embedding model for /v1/embeddings endpoint
ACTIVE_EMBEDDING_MODEL=ai-forever/FRIDA

# Reranker model for /v1/rerank endpoint
ACTIVE_RERANKER_MODEL=DiTy/cross-encoder-russian-msmarco

# Guard model for /v1/moderate endpoint
ACTIVE_GUARD_MODEL=Qwen/Qwen3Guard-Gen-0.6B

# =============================================================================
# Server Settings
# =============================================================================

# Server port (single entry point)
SERVER_PORT=8000

# Default device: auto (GPU if available), cpu, or cuda:N
DEVICE=auto

# Default dtype: float16 (recommended), float32, bf16 (guards)
DTYPE=float16

# Default batch size (adjust based on VRAM)
BATCH_SIZE=32

# =============================================================================
# Runtime Settings
# =============================================================================

# Idle timeout in seconds before auto-unloading a model (0 = disabled)
IDLE_TIMEOUT=1800

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
